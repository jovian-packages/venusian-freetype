{
    "name": "jovian/venusian-freetype",
    "description": "FreeType font face driver for Venusian Topside: metrics, character maps, advances and TrueType and CFF outlines read by FreeType through ext-freetype.",
    "version": "0.11.0",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "topside",
        "typography",
        "freetype"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-freetype/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-freetype/issues",
        "source": "https://github.com/jovian-packages/venusian-freetype"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-freetype": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Typography\\FreeType\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Typography\\FreeType\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Typography\\FreeType\\Providers\\VenusianFreeTypeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
